# ExEF Netlify functions (leads, track-event, sign-download, download-file)
# Set these in the Netlify site environment, not in a committed file.

# Allowed origin for API responses (defaults to https://exef.org)
EFI_CORS_ORIGIN=https://exef.org

# Lead + event storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signed lead-magnet downloads (IEP goal bank PDF)
EFI_DOWNLOAD_SIGNING_SECRET=

# Instant lead notification email via Resend
EFI_RESEND_API_KEY=
EFI_LEAD_NOTIFY_EMAIL=jacob@exef.org
EFI_LEAD_NOTIFY_FROM=

# Newsletter sync
EFI_MAILERLITE_API_KEY=

# Optional webhook fan-out for leads/events
EFI_CRM_WEBHOOK_URL=
EFI_ESP_WEBHOOK_URL=
